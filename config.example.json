{
	"$schema": "config.schema.json",
	"baseUrl": "https://maps.example.com",
	"outPath": "out/",
	"generateWebp": true,
	"optimizeLevel": 3,
	"renderPasses": {
		"include": [
			"icon-smoothing-2025"
		],
		"exclude": [
			"icon-smoothing"
		]
	},
	"categories": [
		{
			"name": "Stations",
			"gamePath": "/path/to/SS13/MyStation",
			"mapFilesPath": "_maps/map_files",
			"automapperConfigPath": "_maps/nova/automapper/automapper_config.toml",
			"maps": [
				{
					"name": "SerenityStation",
					"dmmPath": "SerenityStation/SerenityStation.dmm"
				}
			],
			"subcategories": [
				{
					"name": "Dungeons",
					"maps": [
						{
							"name": "ExampleDungeon",
							"dmmPath": "Dungeons/ExampleDungeon.dmm",
							"supportsPipes": false
						}
					]
				}
			]
		},
		{
			"name": "OtherGame",
			"friendlyName": "Other Game",
			"gamePath": "/path/to/SS13/OtherGame",
			"envFile": "othergame.dme",
			"mapFilesPath": "_maps",
			"supportsPipes": false,
			"doFTL": false,
			"maps": [
				{
					"name": "MainStation",
					"dmmPath": "MainStation/MainStation.dmm",
					"friendlyName": "Main Station"
				}
			]
		}
	]
}
